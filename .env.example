# Prefer: python3 scripts/init-local.py (generates both local secrets).
# Compose reads .env. For native Go: set -a; . ./.env; set +a
BANDIA_HTTP_ADDR=127.0.0.1:8080
POSTGRES_PASSWORD=
BANDIA_MANAGER_TOKEN=
BANDIA_DATABASE_URL=postgres://bandia:REPLACE_PASSWORD@127.0.0.1:5432/bandia?sslmode=disable
# Optional: disposable database used only for integration tests.
# BANDIA_TEST_DATABASE_URL=postgres://bandia:REPLACE_PASSWORD@127.0.0.1:5432/bandia_test?sslmode=disable
